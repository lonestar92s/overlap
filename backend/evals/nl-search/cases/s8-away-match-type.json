{
  "id": "S8-003",
  "scenario": "S8",
  "modes": ["parse"],
  "description": "Single query: away match type extracted for explicit away phrasing.",
  "input": {
    "query": "Arsenal away matches in London next month"
  },
  "expect": {
    "isMultiQuery": false,
    "parsed": {
      "matchTypes": ["away"],
      "teams": {
        "any": {
          "$teamNamesContain": ["Arsenal"]
        }
      },
      "dateRange": {
        "$exists": true
      }
    }
  }
}
